# Claude API key — concept/lore/texture-prompt generation
# https://platform.claude.com/ -> API keys
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI API key — concept art & diffuse texture image generation (gpt-image-1)
# Optional: without it run `generate --no-images` (prompts are still saved)
OPENAI_API_KEY=sk-...

# Meshy AI API key — image-to-3D mesh generation (GLB/FBX/OBJ)
# https://www.meshy.ai/ -> API. Optional: without it the mesh step is skipped
MESHY_API_KEY=msy_...
